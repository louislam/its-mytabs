{
    "lock": false,
    "unstable": [
        "fmt-component"
    ],
    "exclude": [
        "public/font",
        "public/soundfont"
    ],
    "imports": {
        "wasm-media-encoders": "npm:wasm-media-encoders@~0.7.0"
    },
    "fmt": {
        "indentWidth": 4,
        "semiColons": true,
        "singleQuote": false,
        "lineWidth": 200
    }
}
